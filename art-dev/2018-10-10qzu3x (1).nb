Notebook[{

Cell[CellGroupData[{
Cell["GIve a name to it :)", "Section",
 CellChangeTimes->{{3.4254568018686285`*^9, 3.4254568054137263`*^9}, {
  3.425459112320896*^9, 3.425459116126368*^9}}],

Cell["\<\
Clear[c,r,jazmin];
r[u_,v_,c_]=v^(1.6) (0.+(0.01+Abs[Sin[c u/2]] )^(1/3));
jazmin[u_,v_,c_]=Evaluate[
{r[u,v,c] Sin[u]*Cos[v],
r[u,v,c] Cos[u]*Cos[v],
3.5 Abs[Cos[ v]]^(0.7) (2+Sin[c u/2]^2)
}];\
\>", "Input",
 CellChangeTimes->{{3.425458401598928*^9, 3.4254584018593025`*^9}},
 CellLabel->"In[1]:="],

Cell[CellGroupData[{

Cell["\<\
ParametricPlot3D[
Evaluate[jazmin[u,v,5]], {u,-Pi,Pi},{v,0, 3.4},
PlotPoints->50,BoxRatios->Automatic,
 PlotRange->All,Boxed->False,Axes->None,Mesh->None,ColorFunction->(ColorData[\
\"SunsetColors\"][0.9(1-0.9#5)]&)]\
\>", "Input",
 CellChangeTimes->{{3.425456722764883*^9, 3.4254567454875565`*^9}, {
  3.425458204475478*^9, 3.4254582067587614`*^9}, {3.4254582893174753`*^9, 
  3.425458319330632*^9}, {3.4254583809592495`*^9, 3.4254583811595373`*^9}},
 CellLabel->"In[2]:="],

